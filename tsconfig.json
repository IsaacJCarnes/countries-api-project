{
  "compilerOptions": {

    "module": "es2022",
    "target": "esnext",
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./public",

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
  },
}
